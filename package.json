{
  "name": "french-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:secrets && vite build && node scripts/version-sw.mjs && node scripts/check-performance.mjs",
    "preview": "vite preview",
    "check:secrets": "node scripts/check-no-shared-secrets.mjs",
    "test": "node --test tests/*.test.js && node --import ./tests/register-jsx.mjs tests/study-panel.render.test.mjs tests/session-restore.test.mjs tests/today-deps.render.test.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "lint:code": "eslint src",
    "validation:status": "node scripts/validation-status.mjs",
    "validation:import": "node scripts/validation-import.mjs",
    "validation:packet": "node scripts/validation-packet.mjs",
    "check": "npm run check:secrets && npm run lint:content && npm run lint:code && npm test",
    "type-check": "npx tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0"
  }
}
